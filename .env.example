# Copy to .env to override defaults. None of these are required to run
# `npm run dev:all` — the app works out of the box with in-memory storage
# and mock parsing.

# Port the Express API listens on. The Vite dev/preview proxy forwards
# /api/* to this port automatically (see vite.config.ts).
SERVER_PORT=3001

# memory | sql (sql is not implemented yet — see BUILD_PLAN.md Phase 2)
DB_PROVIDER=memory

# mock | openai (openai is not implemented yet — see BUILD_PLAN.md Phase 2)
LLM_PROVIDER=mock

# Only required when LLM_PROVIDER=openai
OPENAI_API_KEY=
