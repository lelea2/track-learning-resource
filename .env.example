# Port the Express API listens on. The Vite dev/preview proxy forwards
# /api/* to this port automatically (see vite.config.ts).
SERVER_PORT=3001

# memory | sql (sql is not implemented yet — see BUILD_PLAN.md Phase 2)
DB_PROVIDER=memory

# mock | openai
LLM_PROVIDER=openai

# Required for LLM_PROVIDER=openai — fill in your own key, do not commit it.
OPENAI_API_KEY=

# Optional, only used when LLM_PROVIDER=openai. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
